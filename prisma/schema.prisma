generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum MediaType {
  MOVIE
  SERIES
}

enum MediaAccess {
  FREE
  PREMIUM
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String?  @db.VarChar(150)
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      UserRole @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reviews        Review[]
  watchlistItems Watchlist[]
  completedMedia CompletedMedia[]

  @@index([role])
  @@map("users")
}

model Genre {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  slug      String   @unique @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mediaGenres MediaGenre[]

  @@map("genres")
}

model Media {
  id             String      @id @default(uuid()) @db.Uuid
  title          String      @db.VarChar(255)
  slug           String      @unique @db.VarChar(300)
  type           MediaType
  access         MediaAccess @default(FREE)
  releaseYear    Int         @map("release_year")
  posterUrl      String?     @map("poster_url") @db.VarChar(500)
  trailerUrl     String?     @map("trailer_url") @db.VarChar(500)
  streamingUrl   String?     @map("streaming_url") @db.VarChar(500)
  isPublished    Boolean     @default(true) @map("is_published")
  isFeatured     Boolean     @default(false) @map("is_featured")
  avgRating      Float       @default(0) @map("avg_rating")
  ratingCount    Int         @default(0) @map("rating_count")
  reviewCount    Int         @default(0) @map("review_count")
  deletedAt      DateTime?   @map("deleted_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  reviews        Review[]
  watchlistItems Watchlist[]
  completedMedia CompletedMedia[]
  mediaGenres    MediaGenre[]

  @@index([type])
  @@index([access])
  @@index([releaseYear])
  @@index([avgRating])
  @@index([reviewCount])
  @@index([isFeatured])
  @@index([isPublished])
  @@index([deletedAt])
  @@map("media")
}

model MediaGenre {
  mediaId   String   @db.Uuid @map("media_id")
  genreId   String   @db.Uuid @map("genre_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([mediaId, genreId])
  @@index([genreId])
  @@map("media_genres")
}

model Review {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid @map("user_id")
  mediaId     String       @db.Uuid @map("media_id")
  rating      Int
  content     String       @db.Text
  hasSpoiler  Boolean      @default(false) @map("has_spoiler")
  status      ReviewStatus @default(PENDING)
  publishedAt DateTime?    @map("published_at")
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId], map: "unique_user_review_per_media")
  @@index([userId])
  @@index([mediaId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt(sort: Desc)])
  @@index([rating])
  @@map("reviews")
}

model Watchlist {
  userId    String   @db.Uuid @map("user_id")
  mediaId   String   @db.Uuid @map("media_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
  @@index([mediaId])
  @@index([createdAt(sort: Desc)])
  @@map("watchlist")
}

model CompletedMedia {
  userId    String   @db.Uuid @map("user_id")
  mediaId   String   @db.Uuid @map("media_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([userId, mediaId])
  @@index([mediaId])
  @@index([createdAt(sort: Desc)])
  @@map("completed_media")
}
